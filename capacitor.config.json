{
  "appId": "ai.akansha.mobile",
  "appName": "Akansha",
  "webDir": "public",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#010208"
  },
  "ios": {
    "backgroundColor": "#010208",
    "contentInset": "always"
  },
  "server": {
    "url": "http://localhost:3000",
    "cleartext": true,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1600,
      "backgroundColor": "#010208",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#010208"
    }
  }
}
