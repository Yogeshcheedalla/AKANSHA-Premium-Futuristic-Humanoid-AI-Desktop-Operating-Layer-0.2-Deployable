{
  "name": "akansha-advanced-humanoid-assistant",
  "productName": "Akansha",
  "version": "3.0.0",
  "private": true,
  "description": "Akansha — a premium multimodal humanoid AI desktop assistant for Windows.",
  "author": {
    "name": "Akansha",
    "email": "team@akansha.ai"
  },
  "homepage": "https://akansha.ai",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prebundle:whisper": "tsx scripts/prebundle-whisper.ts",
    "whisper:verify": "tsx scripts/prebundle-whisper.ts --verify",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d db",
    "db:provision": "tsx scripts/db-provision.ts",
    "db:runtimecheck": "tsx scripts/db-runtime-write-check.ts",
    "db:down": "docker compose stop db",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run prebundle:whisper && npm run build && electron-builder --win nsis portable",
    "release:manifest": "tsx scripts/release-manifest.ts",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:all": "npm run dist:win && npm run dist:mac && npm run dist:linux",
    "dist:android": "npx cap add android && npx cap sync android && cd android && ./gradlew assembleDebug",
    "dist:ios": "npx cap add ios && npx cap sync ios && cd ios && pod install && xcodebuild -scheme App -sdk iphoneos"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "next": "16.2.6",
    "nodemailer": "^10.0.10",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.13.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
