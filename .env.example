# ═══════════════════════════════════════════════════════════
#  AKANSHA — environment configuration (copy to .env)
#  Never commit a real .env. All keys are read SERVER-SIDE only.
# ═══════════════════════════════════════════════════════════

# ── Database (OPTIONAL) ─────────────────────────────────────
# Akansha boots and answers WITHOUT a database (persistence degrades
# gracefully). Set this to enable durable providers, memory, ledger,
# traces and encrypted credentials. A local Postgres is provided via
# docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/akansha

# ── Credential Vault ────────────────────────────────────────
# Secret used to encrypt stored API keys (AES-256-GCM) at rest.
# Set a long random value in production. If unset, DATABASE_URL is used,
# then a development fallback.
AKANSHA_SECRET=

# ── Access model (no mandatory Akansha account) ─────────────
# Basic AI use is accountless by default: the web app can start a low-privilege
# GUEST session (chat only). Guests are blocked from sensitive/execute/install/admin
# routes, which still require a real access/admin token. Set true to require a
# real session for chat too.
# AKANSHA_GUESTS_DISABLED=false
# Local access/admin tokens for full (non-guest) sessions (desktop pairing):
# AKANSHA_ACCESS_TOKEN=
# AKANSHA_ADMIN_TOKEN=
# Dev only: disable auth entirely (NEVER in production).
# AKANSHA_AUTH_DISABLED=

# ── AI model providers (configure ONE or MORE) ──────────────
# Any subset works; ModelRouter picks the best available and falls back.

# Ollama (local, no key required — just run `ollama serve`)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Experiential Labs (OpenAI-compatible) — optional
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1

# OpenRouter — Online AI provider (key is server-only; NEVER in the browser)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OAuth "Connect OpenRouter" (browser PKCE). Per OpenRouter's current PKCE docs there
# is NO client_id requirement — the flow needs only a callback URL. "Continue with
# OpenRouter" sends the user to OpenRouter's own sign-in/sign-up; Akansha never sees
# the OpenRouter password. The callback resolves as:
#   AKANSHA_OPENROUTER_REDIRECT_URI  >  AKANSHA_PUBLIC_URL + /api/ai/online/callback
# In production set AKANSHA_PUBLIC_URL=https://akansha-gamma.vercel.app (the callback
# is then https://akansha-gamma.vercel.app/api/ai/online/callback). If neither is set
# the connect route falls back to the live request origin (works on the deployed site).
AKANSHA_PUBLIC_URL=https://your-domain.example
# Optional: pin an exact callback (must match the deployed origin EXACTLY).
AKANSHA_OPENROUTER_REDIRECT_URI=
# OPTIONAL only — forwarded to OpenRouter ONLY if you register one later; never
# required and never fabricated.
AKANSHA_OPENROUTER_CLIENT_ID=
# Optional: label OpenRouter gives the created key, and an authorize-endpoint override.
AKANSHA_OPENROUTER_KEY_LABEL=Akansha
AKANSHA_OPENROUTER_AUTHORIZE_URL=

# ── Google sign-in (server-side Authorization Code + PKCE) ───
# The CLIENT SECRET is server-only. NEVER prefix it with NEXT_PUBLIC_, never commit
# it, never paste it into code/logs/tests. Configure it ONLY in Vercel env vars.
# If unset, Google sign-in honestly reports "not configured" and the rest of Akansha
# keeps working. Register the redirect URI EXACTLY in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact override; otherwise derived from AKANSHA_PUBLIC_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Production redirect (register in Google Cloud):
#   https://akansha-gamma.vercel.app/api/auth/google/callback

# ── SMTP (transactional email ONLY — never an auth mechanism) ─
# Server-side only. SMTP_PASS is a SECRET: configure it ONLY in Vercel env vars,
# never NEXT_PUBLIC_, never commit or paste into chat/logs/code. Google is the only
# identity provider; SMTP sends welcome/login/security/system emails.
# Port 465 = implicit TLS (SMTP_SECURE=true); 587 = STARTTLS (SMTP_SECURE=false).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Akansha
SMTP_REPLY_TO=

# ── Release manifest (truth-driven downloads; GET /api/releases) ─
# JSON array of hosted artifacts to HEAD-verify. Availability is NEVER invented —
# a button is enabled only when the URL actually serves bytes. Leave unset until you
# publish real artifacts to GitHub Releases / a CDN, and the landing shows every
# platform as "Coming soon / Build required".
# Example:
#   AKANSHA_RELEASES=[{"platform":"windows","architecture":"x64","type":"installer","filename":"Akansha-Setup-x64.exe","url":"https://github.com/<org>/<repo>/releases/download/v3.0.0/Akansha-Setup-x64.exe","sha256":"<64hex>","version":"3.0.0"}]
AKANSHA_RELEASES=

# ── Local AI (DESKTOP ONLY — never runs on Vercel) ───────────
# Where to look for an installed llama.cpp CLI (comma-separated absolute paths).
LLAMA_CPP_PATHS=
# Signed model catalog + the PUBLIC verification key (private key stays under
# gitignored .akansha-keys/ and is NEVER committed).
AKANSHA_MODEL_CATALOG=
AKANSHA_CATALOG_PUBKEY_FILE=

# ── Development fixtures (NEVER enable in production) ─────────
# Only when NODE_ENV=development does this let the Model Center load a
# self-signed dev fixture catalog to exercise the UI/state machine without
# downloading a real model. A fixture is never marked usable.
# AKANSHA_ALLOW_FIXTURE_CATALOG=1
