# ═══════════════════════════════════════════════════════════
#  AKANSHA — environment configuration (copy to .env)
#  Never commit a real .env. All keys are read SERVER-SIDE only.
# ═══════════════════════════════════════════════════════════

# ── Database (OPTIONAL) ─────────────────────────────────────
# Akansha boots and answers WITHOUT a database (persistence degrades
# gracefully). Set this to enable durable providers, memory, ledger,
# traces and encrypted credentials. A local Postgres is provided via
# docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/akansha

# ── Credential Vault ────────────────────────────────────────
# Secret used to encrypt stored API keys (AES-256-GCM) at rest.
# Set a long random value in production. If unset, DATABASE_URL is used,
# then a development fallback.
AKANSHA_SECRET=

# ── Access model (no mandatory Akansha account) ─────────────
# Basic AI use is accountless by default: the web app can start a low-privilege
# GUEST session (chat only). Guests are blocked from sensitive/execute/install/admin
# routes, which still require a real access/admin token. Set true to require a
# real session for chat too.
# AKANSHA_GUESTS_DISABLED=false
# Local access/admin tokens for full (non-guest) sessions (desktop pairing):
# AKANSHA_ACCESS_TOKEN=
# AKANSHA_ADMIN_TOKEN=
# Dev only: disable auth entirely (NEVER in production).
# AKANSHA_AUTH_DISABLED=

# ── AI model providers (configure ONE or MORE) ──────────────
# Any subset works; ModelRouter picks the best available and falls back.

# Ollama (local, no key required — just run `ollama serve`)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Experiential Labs (OpenAI-compatible) — optional
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1

# OpenRouter — Online AI provider (key is server-only; NEVER in the browser)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OAuth "Connect OpenRouter" (PKCE). Leave unset to keep Online AI honestly
# "not configured". REDIRECT must match the deployed origin EXACTLY.
AKANSHA_OPENROUTER_CLIENT_ID=
AKANSHA_OPENROUTER_REDIRECT_URI=https://your-domain.example/api/ai/online/callback
AKANSHA_PUBLIC_URL=https://your-domain.example

# ── Local AI (DESKTOP ONLY — never runs on Vercel) ───────────
# Where to look for an installed llama.cpp CLI (comma-separated absolute paths).
LLAMA_CPP_PATHS=
# Signed model catalog + the PUBLIC verification key (private key stays under
# gitignored .akansha-keys/ and is NEVER committed).
AKANSHA_MODEL_CATALOG=
AKANSHA_CATALOG_PUBKEY_FILE=

# ── Development fixtures (NEVER enable in production) ─────────
# Only when NODE_ENV=development does this let the Model Center load a
# self-signed dev fixture catalog to exercise the UI/state machine without
# downloading a real model. A fixture is never marked usable.
# AKANSHA_ALLOW_FIXTURE_CATALOG=1
